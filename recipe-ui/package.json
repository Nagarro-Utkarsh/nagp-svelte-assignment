{
  "name": "@utkarsh-mahajan/recipe-ui",
  "version": "1.0.0",
  "description": "Reusable web components for the Recipe Finder & Meal Planner app, built with StencilJS.",
  "license": "MIT",
  "keywords": [
    "stencil",
    "web-components",
    "custom-elements",
    "recipe",
    "svelte"
  ],
  "type": "module",
  "types": "dist/components/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/components/index.d.ts"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "stencil build",
    "start": "stencil build --dev --watch --serve",
    "generate": "stencil generate",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@stencil/core": "^4.22.0",
    "@types/node": "^22.10.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
